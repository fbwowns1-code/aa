OPENAI_API_KEY=sk-여기에-발급받은-키-입력

# 본문/제목 생성에 쓸 모델 (웹 검색 tool 지원 모델이어야 한다)
OPENAI_MODEL=gpt-4o

# 이미지 생성 모델
OPENAI_IMAGE_MODEL=gpt-image-1

# OpenAI Responses API의 웹 검색 tool 이름.
# 계정/모델에 따라 web_search_preview 또는 web_search 중 하나를 사용한다.
OPENAI_WEB_SEARCH_TOOL=web_search_preview

# departments/onboarding_publishing.py로 저장한 네이버 로그인 세션(쿠키) 파일 경로.
# secrets/ 아래에만 둔다(.gitignore로 보호됨) — 계정별 경로는 core/accounts.py가 자동으로 정한다.
NAVER_SESSION_FILE=secrets/naver_session.json

# departments/onboarding_design.py로 저장한 챗지피티 웹채팅 세션(쿠키) 파일 경로
# (인포그래픽을 챗지피티 웹채팅 레거시 경로로 만들 때만 필요 — 기본은 OpenAI 이미지 API)
CHATGPT_SESSION_FILE=secrets/chatgpt_session.json

# 시스템 프롬프트(지침) 파일 경로
PROMPT_PATH=prompts/system_prompt.txt

# 이미지 생성 기본 경로. openai_api(기본) 또는 chatgpt_web(레거시)
IMAGE_PROVIDER=openai_api

# 실패 알림(core/notify.py) — 야간 무인 배치가 멈추거나 스케줄러가 죽었을 때
# 알려준다. 아래 둘 다 비워두면 콘솔/로그에만 남긴다(선택 기능).
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_SMTP_HOST=
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_SMTP_USER=
NOTIFY_EMAIL_SMTP_PASSWORD=
